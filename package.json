{
  "name": "zooplay",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "pnpm build && wrangler deploy --config dist/zooplay/wrangler.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:seed": "node --experimental-strip-types scripts/generate-supabase-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "phaser": "^4.1.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.142.0"
  }
}
